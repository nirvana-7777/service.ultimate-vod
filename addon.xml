<?xml version="1.0" encoding="UTF-8"?>
<addon id="service.ultimate-vod" version="1.0.0" name="Ultimate VOD Service" provider-name="ultimate-vod">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.31.0"/>
        <import addon="plugin.video.ultimate" version="2.0.0" optional="true"/>
    </requires>
    
    <extension point="xbmc.service" library="service.py" start="startup">
        <provides>service</provides>
    </extension>
    
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Ultimate VOD Library Sync Service</summary>
        <description lang="en_GB">
            Background service for Ultimate VOD.
            Automatically syncs VOD library with Kodi using the crawler API.
        </description>
        <platform>all</platform>
        <license>MIT</license>
        <source>https://github.com/your-repo/service.ultimate-vod</source>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
